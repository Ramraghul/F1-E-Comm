# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
ENABLE_SWAGGER=true

# --- Database ---
# Local (docker-compose): mongodb://mongo:27017/shopswift
# Local (no docker):      mongodb://127.0.0.1:27017/shopswift
# Atlas (prod):           mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/shopswift
MONGODB_URI=mongodb://127.0.0.1:27017/shopswift

# --- JWT ---
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Stripe (TEST MODE keys only, from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Seed / demo credentials ---
SEED_ADMIN_EMAIL=admin@shopswift.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_RACETEAM_PASSWORD=RaceTeam@12345
SEED_CUSTOMER_PASSWORD=Customer@12345
